# =============================================================================
# Findly Backend — Variáveis de ambiente (modelo)
# =============================================================================
# Copie para `.env` e ajuste os valores:
#     cp .env.example .env
#
# Os valores abaixo assumem execução LOCAL (fora do Docker, host = localhost).
# No Docker Compose os hosts (db/redis) são sobrescritos automaticamente.
# =============================================================================

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=dev-insecure-troque-esta-chave-em-producao
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_TIME_ZONE=America/Sao_Paulo
DJANGO_SETTINGS_MODULE=config.settings

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=findly
POSTGRES_USER=findly
POSTGRES_PASSWORD=findly
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Opcional: sobrescreve as variáveis acima se informado.
# DATABASE_URL=postgres://findly:findly@localhost:5432/findly

# --- Redis (cache + broker do Celery) ---------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- CORS -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Admin seguro + Honeypot -------------------------------------------------
# Caminho secreto do Django Admin (o /admin/ clássico vira honeypot).
# Gere um valor aleatório com: make gen-secret
DJANGO_ADMIN_URL=painel-interno/
HONEYPOT_ENABLED=True
HONEYPOT_DELAY_SECONDS=0
HONEYPOT_BLOCK_THRESHOLD=5
HONEYPOT_BLOCK_TTL_SECONDS=86400
HONEYPOT_LOG_CREDENTIALS=True
HONEYPOT_CAPTURE_PASSWORD_PLAINTEXT=False
HONEYPOT_TRUSTED_IPS=127.0.0.1,::1,localhost
HONEYPOT_BLOCK_PRIVATE_IPS=False

# --- E-mail (em dev usa o backend de console) -------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Findly <no-reply@findly.local>

# --- API --------------------------------------------------------------------
API_PAGE_SIZE=20
THROTTLE_ANON=60/min
THROTTLE_USER=1000/day

# --- JWT --------------------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Autenticação (cadastro, verificação e reset de senha) -------------------
# Exige confirmação de e-mail antes do primeiro login.
AUTH_REQUIRE_EMAIL_VERIFICATION=True
# Validade dos tokens de uso único (segundos).
EMAIL_VERIFICATION_TIMEOUT=86400
PASSWORD_RESET_TIMEOUT=3600
# Limites das rotas de autenticação (throttling por IP/usuário).
THROTTLE_AUTH=20/min
THROTTLE_REGISTER=5/hour
THROTTLE_PASSWORD_RESET=5/hour
# Base das URLs enviadas por e-mail (o front-end recebe ?uid=...&token=...).
FRONTEND_URL=http://localhost:3000
# Opcional: sobrescreve as URLs montadas a partir de FRONTEND_URL.
# EMAIL_VERIFICATION_URL=http://localhost:3000/verificar-email
# PASSWORD_RESET_URL=http://localhost:3000/redefinir-senha

# --- Uploads de mídia -------------------------------------------------------
MAX_UPLOAD_SIZE_MB=5
