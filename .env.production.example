# =============================================================================
# Findly Backend — Variáveis de ambiente de PRODUÇÃO (exemplo)
# =============================================================================
# Copie para .env.production e preencha os valores reais. NUNCA versione o
# arquivo final. Suba com:
#
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# As variáveis abaixo também são usadas na interpolação do compose (por isso o
# --env-file é obrigatório).
# =============================================================================

# --- Django ----------------------------------------------------------------
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=gere-uma-chave-aleatoria-longa-e-unica
DJANGO_ALLOWED_HOSTS=api.findly.example
DJANGO_ADMIN_URL=painel-interno
DJANGO_TIME_ZONE=America/Sao_Paulo
DJANGO_LOG_LEVEL=INFO

# --- CORS / CSRF -----------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://app.findly.example
CSRF_TRUSTED_ORIGINS=https://app.findly.example

# --- Banco de dados --------------------------------------------------------
POSTGRES_DB=findly
POSTGRES_USER=findly
POSTGRES_PASSWORD=troque-esta-senha
DB_CONN_MAX_AGE=60

# --- Redis / Celery --------------------------------------------------------
# O compose monta REDIS_URL, CELERY_BROKER_URL e CELERY_RESULT_BACKEND a partir
# desta senha, apontando para o host interno `redis`.
REDIS_PASSWORD=troque-esta-senha-tambem
CELERY_CONCURRENCY=2

# --- Servidor --------------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
HTTP_PORT=80

# --- E-mail ----------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.exemplo.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@findly.example
EMAIL_HOST_PASSWORD=troque
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Findly <no-reply@findly.example>
FRONTEND_URL=https://app.findly.example

# --- Notificações ----------------------------------------------------------
NOTIFICATIONS_ASYNC_ENABLED=True
NOTIFICATIONS_PUSH_ENABLED=True
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@findly.example
MATCH_WINDOW_DAYS=30
MATCH_NOTIFICATION_LIMIT=5

# --- Segurança (aplicado apenas com DJANGO_DEBUG=False) --------------------
# Mantenha True quando houver TLS (no nginx ou em um proxy à frente) enviando
# X-Forwarded-Proto: https.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- Honeypot / admin ------------------------------------------------------
HONEYPOT_LOG_CREDENTIALS=True
HONEYPOT_CAPTURE_PASSWORD_PLAINTEXT=False
HONEYPOT_TRUSTED_IPS=
HONEYPOT_BLOCK_PRIVATE_IPS=False

# --- Manutenção ------------------------------------------------------------
ITEM_EXPIRATION_DAYS=90
LOST_REPORT_EXPIRATION_DAYS=90
WITHDRAWAL_QR_RETENTION_DAYS=7

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=5
